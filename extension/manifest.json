{
  "manifest_version": 3,
  "name": "BABY Page Pet",
  "description": "A movable voice companion for chatting about webpages and attachments.",
  "version": "1.3.1",
  "key": "",
  "action": {
    "default_title": "Open BABY Page Pet",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  },
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "web_accessible_resources": [
    {
      "resources": ["pet.webp"],
      "matches": ["https://*/*", "http://*/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*/*",
        "http://*/*"
      ],
      "js": [
        "page-context.js",
        "pet-theme.js",
        "pet-capabilities.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
